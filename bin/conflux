#!/bin/bash
set -e

source_path=$0
while [[ -L "$source_path" ]]; do
    target=$(readlink "$source_path")
    case "$target" in
        /*) source_path=$target ;;
        *) source_path="$(dirname "$source_path")/$target" ;;
    esac
done
ROOT=$(CDPATH= cd -- "$(dirname "$source_path")/.." && pwd -P)

case "${1-}" in
    dispatch|usage)
        command=$1
        shift
        options=()
        policy_set=false
        ledger_set=false
        while [[ $# -gt 0 && $1 != -- ]]; do
            case "$1" in
                --policy|--policy=*) policy_set=true ;;
                --ledger|--ledger=*) ledger_set=true ;;
            esac
            options+=("$1")
            shift
        done
        if [[ "$command" == dispatch && "$policy_set" == false ]]; then
            options+=(--policy "${CONFLUX_POLICY:-$HOME/.config/conflux/policy.json}")
        fi
        if [[ "$ledger_set" == false ]]; then
            options+=(--ledger "${CONFLUX_LEDGER:-$HOME/.local/state/conflux/ledger.jsonl}")
        fi
        set -- "$command" "${options[@]}" "$@"
        ;;
esac
exec python3 "$ROOT/conflux.py" "$@"
