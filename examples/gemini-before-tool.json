{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.orca/agent-hooks/gemini-hook.sh\""
          }
        ]
      },
      {
        "matcher": "^(write_file|replace|edit_file|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "# Auxiliary write-tool guard. Workspace permissions must block indirect shell writes.\ncat >/dev/null; printf '%s\\n' '{\"decision\":\"deny\",\"reason\":\"read-only\"}'"
          }
        ]
      }
    ]
  }
}
